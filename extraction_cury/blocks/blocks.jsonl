{"block_id": "f8f63e63-cd45-5230-8fd5-3f3263a1ab10", "document_id": "cdce3fea-723b-5de2-b3e8-a3dbb90939ad", "page_number": 4, "section_id": "12097fa3-49c1-5fbc-91b2-4fdbabc67f64", "section_title": "R$ 2.646,8 MILHÕES", "parent_block_id": null, "order_index": 34, "level_hint": 1, "item_type": "TextItem", "label_raw": "text", "label_canonical": "text", "role_hint": "paragraph", "text": "No 1T26, foram lançados 10 empreendimentos, sendo 7 localizados em SP e 3 no RJ, totalizando o VGV de", "self_ref": "#/texts/33", "parent_ref": "#/body", "child_refs": [], "caption_refs": [], "reference_refs": [], "bbox": {"page_number": 4, "left": 28.2, "top": 434.6846, "right": 425.4008, "bottom": 390.36356, "coord_origin": "BOTTOMLEFT"}, "provenance_kind": "layout"}
