COMPOSE_PROJECT_NAME=ocr_cidades_local

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_DATA_LAKE=ocr-cidades
MINIO_IMAGE_TAG=RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE_TAG=RELEASE.2025-08-13T08-35-41Z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_DOCUMENT_PREFIX=documentos-origem/construtoras
MINIO_EXTRACT_PREFIX=execucoes/construtoras/extracao
MINIO_RESOLUTION_PREFIX=execucoes/construtoras/resolucao
MINIO_CONTRACT_PREFIX=contratos/construtoras
MINIO_LAYOUT_PREFIX=layouts/construtoras

PIPELINE_TMP_DIR=/opt/pipeline-tmp
HF_HOME=/opt/huggingface-cache
HF_TOKEN=
REFERENCE_DATE=
FORCE_EXTRACT=false
DOCLING_RUNNER_IMAGE_TAG=python3.11
# Para processamento remoto, troque pelo endereco do Mac Studio na VPN, por exemplo:
# DOCLING_RUNNER_BASE_URL=http://10.8.0.20:8081
DOCLING_RUNNER_BASE_URL=http://docling-runner:8081
DOCLING_RUNNER_TIMEOUT_SECONDS=4000
DOCLING_RUNNER_EXECUTION_TIMEOUT_SECONDS=3600
RI_DOWNLOAD_TIMEOUT_SECONDS=120
RI_DOWNLOAD_MAX_ATTEMPTS=3
RI_DOWNLOAD_RETRY_DELAY_SECONDS=5
DOCLING_DO_OCR=true
DOCLING_DO_CHART_EXTRACTION=false
DOCLING_ENABLE_LLM_TEXT_EXTRACTION=false
DOCLING_LLM_API_URL=
DOCLING_LLM_API_MODEL=
DOCLING_LLM_TIMEOUT=180
DOCLING_LLM_MAX_TOKENS=4096
DOCLING_TEXT_CANDIDATE_WINDOW_BEFORE=1
DOCLING_TEXT_CANDIDATE_WINDOW_AFTER=1
DOCLING_TEXT_CANDIDATE_MAX_CHARS=2500
DOCLING_TEXT_CANDIDATE_MIN_CHARS=40
DOCLING_TEXT_CANDIDATE_MAX_PER_SECTION=50

# LLM usada pela DAG 3 para propor atualizacoes de layout signature.
# OpenAI/API compativel:
FALLBACK_LLM_PROVIDER=openai
FALLBACK_LLM_API_URL=https://api.openai.com/v1
FALLBACK_LLM_API_KEY=
# Se FALLBACK_LLM_API_KEY ficar vazio, a DAG 3 tambem aceita OPENAI_API_KEY.
# OPENAI_API_KEY=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_TIMEOUT_SECONDS=180
FALLBACK_LLM_MAX_TOKENS=4096
# Limites por etapa da DAG 3: selecao e barata/objetiva; fragmento pode raciocinar.
FALLBACK_LLM_SELECTION_MAX_TOKENS=2048
FALLBACK_LLM_SELECTION_THINKING_MODE=disabled
FALLBACK_LLM_FRAGMENT_MAX_TOKENS=8192
FALLBACK_LLM_FRAGMENT_THINKING_MODE=enabled
# Ollama local/remoto:
# FALLBACK_LLM_PROVIDER=ollama
# FALLBACK_LLM_API_URL=http://host.docker.internal:11434
# FALLBACK_LLM_MODEL=llama3.1:8b

POSTGRES_OPERACIONAL_USER=ocr_admin
POSTGRES_OPERACIONAL_PASSWORD=ocr_admin_password
POSTGRES_OPERACIONAL_DB=ocr_operacional
POSTGRES_OPERACIONAL_PORT=5433

AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow_core
AIRFLOW_VERSION=3.0.2-python3.11
POSTGRES_AIRFLOW_PORT=5434
AIRFLOW_PORT=18080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_WEBSERVER_SECRET_KEY=airflow_secret_key_local
AIRFLOW_API_AUTH_JWT_SECRET=airflow_execution_jwt_secret_local
AIRFLOW_FERNET_KEY=4p9xDg0m2Y8vQv0B7o4t7x4mQKc6S9E1sP2R5T8U0W0=
AIRFLOW_API_BASE_URL=http://airflow-webserver:8080
AIRFLOW_EXECUTION_API_SERVER_URL=http://airflow-webserver:8080/execution/

OM_DB_USER=openmetadata
OM_DB_PASSWORD=openmetadata_password
OM_DB_NAME=openmetadata_db
OPENMETADATA_ADMIN_EMAIL=admin@open-metadata.org
OPENMETADATA_ADMIN_PASSWORD=admin
POSTGRES_OPENMETADATA_PORT=5435
OPENMETADATA_BOOTSTRAP_MAX_ATTEMPTS=30
OPENMETADATA_BOOTSTRAP_RETRY_SECONDS=15
OPENMETADATA_CATALOG_SYNC_INTERVAL_SECONDS=300
# Owner padrão dos ativos criados pelo bootstrap. Em produção, substitua por uma equipe real.
OPENMETADATA_DEFAULT_OWNER_TYPE=user
OPENMETADATA_DEFAULT_OWNER_FQN=admin

OPENMETADATA_VERSION=1.12.6
OPENMETADATA_CLUSTER_NAME=ocr-cidades-local
OPENMETADATA_LOG_LEVEL=INFO
OPENMETADATA_PORT=8585
OPENMETADATA_ADMIN_PORT=8586

ELASTICSEARCH_PORT=9200
ELASTICSEARCH_CLUSTER_ALIAS=ocr-cidades-local

# Observabilidade e metricas do fluxo Atlas (Langfuse).
# LANGFUSE_ENABLED so tem efeito se as tres credenciais abaixo existirem.
LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Separa execucoes de desenvolvimento, homologacao e producao no mesmo projeto.
LANGFUSE_ENVIRONMENT=development
# Fracao de execucoes observadas; 1.0 observa todas.
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_TIMEOUT_SECONDS=10
# Rotulo de versao do projeto. Vazio deriva de git: dev-<branch>-<sha>[-dirty]
# em desenvolvimento e prod-<tag> em producao. Preencha para rotular experimentos.
ATLAS_RELEASE=

# Resolve os prompts do fallback pelo Langfuse em vez do espelho em codigo.
# Desligado por padrao: ligar muda a origem do texto enviado a LLM, e essa
# mudanca deve ser medida contra a linha de base antes de virar o normal.
# Se o Langfuse nao responder, a execucao cai para o codigo e segue.
ATLAS_PROMPTS_LANGFUSE_ENABLED=false
# Rotulo de prompt lido em execucao. Trocar aqui troca o conjunto inteiro,
# o que permite rodar um experimento sem mexer no que esta em producao.
ATLAS_PROMPT_LABEL=production

# Banco do proprio Langfuse. Usado apenas pelos scripts de dashboard,
# porque o Langfuse nao expoe API publica para criar paineis.
LANGFUSE_DATABASE_HOST=
LANGFUSE_DATABASE_PORT=5432
LANGFUSE_DATABASE_NAME=
LANGFUSE_DATABASE_USERNAME=
LANGFUSE_DATABASE_PASSWORD=
