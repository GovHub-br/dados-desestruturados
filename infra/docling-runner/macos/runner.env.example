# Configuracao do runner Docling no Mac Studio.
# Copie para ~/docling-runner/runner.env (chmod 600). Lido por run-runner.sh.
#
# Nao copie o .env do repositorio inteiro: ele traz caminhos de Docker
# (/opt/...) e credenciais da VM que nao se aplicam aqui.

# Servidor HTTP chamado pela VM (DOCLING_RUNNER_BASE_URL=http://<ip-do-mac>:8081).
DOCLING_RUNNER_HOST=0.0.0.0
DOCLING_RUNNER_PORT=8081

# Area de trabalho dos jobs e cache de modelos do Hugging Face.
PIPELINE_TMP_DIR=/Users/lablivre/ocr-data/pipeline-tmp
HF_HOME=/Users/lablivre/ocr-data/huggingface-cache

# Configuracao do pipeline (lida pelo subprocesso docling_pipeline).
# Acrescente aqui as linhas DOCLING_LLM_* e DOCLING_TEXT_CANDIDATE_* em uso:
#   grep -E '^DOCLING_(LLM|TEXT_CANDIDATE)_' <.env atual> >> ~/docling-runner/runner.env
# Sem DOCLING_LLM_API_URL/MODEL, toda extracao com LLM pedida pela VM aborta.
